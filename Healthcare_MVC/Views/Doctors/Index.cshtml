@model IEnumerable<HealthcareClinic.API.Models.Entities.Doctor>
@{
    ViewData["Title"] = "Manage Doctors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-person-badge"></i> Manage Doctors
        </h2>
        @* FIX #3: Add Doctor button *@
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Add Doctor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        @foreach (var doc in Model)
        {
            bool isActive = doc.User?.IsActive ?? true;

            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm rounded-3 @(!isActive ? "opacity-75 border border-danger" : "")">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-dark mb-0">
                                @doc.Name
                            </h5>
                            @* FIX #4: Status badge *@
                            @if (isActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </div>

                        <p class="text-muted small mb-3">@doc.Email</p>
                        <p class="text-muted small mb-3">
                            <strong>CPR:</strong> @doc.CPR
                        </p>
                        <div class="bg-light p-3 rounded-2 mb-3">
                            <p class="mb-2">
                                <strong>Shift Hours:</strong>
                                <span class="text-primary">@doc.WorkingHours</span>
                            </p>
                            <p class="mb-0">
                                <strong>Days Off:</strong>
                                <span class="text-danger">@doc.DaysOff</span>
                            </p>
                        </div>

                        @* FIX #2: Many-to-many specializations display *@
                        @if (doc.DoctorSpecializations != null && doc.DoctorSpecializations.Any())
                        {
                            <div class="mt-2">
                                <strong class="small text-muted">Specializations:</strong>
                                <div class="mt-1">
                                    @foreach (var ds in doc.DoctorSpecializations)
                                    {
                                        <span class="badge bg-info text-white me-1 mb-1">
                                            @ds.Specialization?.Name
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mt-2 mb-0">No specializations assigned.</p>
                        }

                        @* FIX #3 & #4: Edit, Set Status, Delete — NO "Add Schedule" button *@
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <a class="btn btn-outline-primary btn-sm"
                               asp-action="Edit" asp-route-id="@doc.Id">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>

                            @* FIX #4: Set Doctor Status button (toggle) *@
                            <form asp-action="SetStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@doc.Id" />
                                <input type="hidden" name="isActive" value="@(!isActive ? "true" : "false")" />
                                <button type="submit"
                                        class="btn btn-sm @(isActive ? "btn-warning" : "btn-success")"
                                        onclick="return confirm('@(isActive ? "Deactivate this doctor? Future appointments will be cancelled." : "Activate this doctor?")')">
                                    <i class="bi @(isActive ? "bi-slash-circle" : "bi-check-circle") me-1"></i>
                                    @(isActive ? "Deactivate" : "Activate")
                                </button>
                            </form>

                            <a class="btn btn-outline-danger btn-sm"
                               asp-action="Delete" asp-route-id="@doc.Id">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

</div>
