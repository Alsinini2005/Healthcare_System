@model HealthcareClinic.API.Models.Entities.Doctor
@using System.Linq
@{
    ViewData["Title"] = "Add Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">
        <i class="bi bi-person-plus"></i> Add New Doctor
    </h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <asp-validation-summary asp-validation-summary="All" />
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @* FIX #1: Doctor Name and Email create both a User row AND a Doctor row *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Dr. John Smith" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="doctor@clinic.com" required />
                </div>
                <div class="form-group mb-3">
                    <label>CPR</label>
                    <input asp-for="CPR"
                           type="text"
                           class="form-control"
                           maxlength="9"
                           placeholder="Enter 9-digit CPR"
                           pattern="\d{9}"
                           required />
                    <span asp-validation-for="CPR" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Password (for login)</label>
                    <input name="password" type="password" class="form-control"
                           placeholder="Leave blank to use default: password123" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Working Hours</label>
                    <div class="d-flex align-items-center gap-2">
                        <div>
                            <label class="form-label text-muted small">From</label>
                            <input type="time" id="startTime" class="form-control" value="08:00" required />
                        </div>
                        <div class="mt-3">—</div>
                        <div>
                            <label class="form-label text-muted small">To</label>
                            <input type="time" id="endTime" class="form-control" value="16:00" required />
                        </div>
                    </div>
                    <!-- hidden field that combines both into "08:00 - 16:00" format for the model -->
                    <input asp-for="WorkingHours" type="hidden" id="workingHoursHidden" />
                    <span asp-validation-for="WorkingHours" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Days Off</label>
                    <input asp-for="DaysOff" class="form-control" placeholder="e.g. Friday, Saturday" required />
                </div>

                @* FIX #2: Many-to-many specializations via checkboxes *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Specializations</label>
                    <div class="d-flex flex-wrap gap-3 mt-1">
                        @foreach (var spec in (ViewBag.AllSpecializations as List<HealthcareClinic.API.Models.Entities.Specialization> ?? new()))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="specializationIds" value="@spec.Id"
                                       id="spec_@spec.Id" />
                                <label class="form-check-label" for="spec_@spec.Id">
                                    @spec.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Save Doctor
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>

            </form>
            @section Scripts {
                <script>
                                function updateWorkingHours() {
                                    var start = document.getElementById('startTime').value;
                                    var end = document.getElementById('endTime').value;
                                    document.getElementById('workingHoursHidden').value = start + ' - ' + end;
                                }

                                document.getElementById('startTime').addEventListener('change', updateWorkingHours);
                                document.getElementById('endTime').addEventListener('change', updateWorkingHours);

                                // Run once on load to populate the hidden field
                                updateWorkingHours();
                </script>
            }
        </div>
    </div>

</div>
