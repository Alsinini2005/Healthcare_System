@model HealthcareClinic.API.Models.Entities.Doctor
@using System.Linq
@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">
        <i class="bi bi-pencil-square"></i> Edit Doctor
    </h2>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="UserId" type="hidden" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="form-group mb-3">
                    <label>CPR</label>
                    <input asp-for="CPR" class="form-control" required maxlength="9" />
                    <span asp-validation-for="CPR" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Working Hours</label>
                    <input asp-for="WorkingHours" class="form-control" placeholder="e.g. 08:00 - 16:00" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Days Off</label>
                    <input asp-for="DaysOff" class="form-control" placeholder="e.g. Friday, Saturday" required />
                </div>

                @* FIX #2: Many-to-many specializations checkboxes *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Specializations</label>
                    <div class="d-flex flex-wrap gap-3 mt-1">
                        @{
                            var currentSpecIds = Model.DoctorSpecializations?.Select(ds => ds.SpecializationId).ToHashSet() ?? new();
                            var allSpecs = ViewBag.AllSpecializations as List<HealthcareClinic.API.Models.Entities.Specialization> ?? new();
                        }
                        @foreach (var spec in allSpecs)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="specializationIds" value="@spec.Id"
                                       id="spec_@spec.Id"
                                @(currentSpecIds.Contains(spec.Id) ? "checked" : "") />
                                <label class="form-check-label" for="spec_@spec.Id">
                                    @spec.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Update Doctor
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</div>
