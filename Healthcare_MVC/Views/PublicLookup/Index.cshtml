@{
    ViewData["Title"] = "Public Appointment Lookup";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="display-6 text-warning mb-2"><i class="bi bi-search"></i></div>
                        <h3 class="text-dark font-weight-bold">Public Clinic Lookup</h3>
                        <p class="text-muted small">View your upcoming appointments and medical summary without creating a system account.</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger font-small py-2 shadow-sm">
                            <i class="bi bi-exclamation-circle-fill"></i> @ViewBag.ErrorMessage
                        </div>
                    }

                    <form asp-action="Search" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label font-weight-bold text-dark small">National CPR ID Number</label>
                            <input type="text" name="cprNumber" class="form-control border-2" placeholder="e.g. 990123456" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-bold text-dark small">Patient Reference Number</label>
                            <input type="text" name="patientRefNumber" class="form-control border-2" placeholder="e.g. REF-2026-XYZ" required />
                        </div>

                        <button type="submit" class="btn btn-warning w-100 py-2 font-weight-bold text-dark text-uppercase shadow-sm">
                            Look Up Records
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>