@model Healthcare_System_AdavanceProgrammingProject.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Patient Portal Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="p-4 bg-white border rounded-3 shadow-sm mb-4">
                <h2 class="text-primary font-weight-bold mb-1">Welcome Back, @Model.CurrentUserName</h2>
                <p class="text-muted mb-0">Book appointments and review your clinic visit history.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success shadow-sm">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
            }

            @* ── Book Appointment Form (FIX #6: specialty-first flow) ── *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-primary text-white font-weight-bold py-3">
                    <i class="bi bi-calendar-plus me-2"></i>Book a New Appointment
                </div>
                <div class="card-body">
                    <form asp-action="BookAppointment" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                       

                        @* STEP 1: Choose Specialty first *@
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">1. Select Specialty</label>
                            <select id="specialtySelect" class="form-select border-2" required>
                                <option value="">-- Choose a Specialty --</option>
                                @foreach (var spec in (ViewBag.AllSpecializations as List<HealthcareClinic.API.Models.Entities.Specialization> ?? new()))
                                {
                                    <option value="@spec.Name">@spec.Name</option>
                                }
                            </select>
                            @* Hidden field sends the chosen specialty to the server *@
                            <input type="hidden" name="specialty" id="specialtyHidden" />
                        </div>

                        @* STEP 2: Doctor list filtered by chosen specialty *@
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">2. Select Doctor</label>
                            <select name="doctorId" id="doctorSelect" class="form-select border-2" required>
                                <option value="">-- Select Specialty First --</option>
                            </select>
                        </div>

                        @* STEP 3: Date & Time *@
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">3. Preferred Date & Time</label>
                            @{
                                // FIX #5: set min date to today to prevent past/wrong-year dates
                                var minDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                            }
                            <input name="appointmentDate" type="datetime-local"
                                   class="form-control border-2"
                                   min="@minDate"
                                   required />
                        </div>

                        <div class="col-12">
                            <div id="doctorInfo" class="alert alert-info py-2 small d-none">
                                <i class="bi bi-info-circle me-1"></i>
                                <span id="doctorInfoText"></span>
                            </div>
                        </div>

                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary font-weight-bold px-4">
                                <i class="bi bi-check-circle me-2"></i>Request Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* ── Appointments with Prescriptions ── *@
            <h5 class="text-muted text-uppercase font-weight-bold small mb-3">Your Appointments</h5>

            @if (Model.ActiveAppointments == null || !Model.ActiveAppointments.Any())
            {
                <div class="alert alert-light border p-4 text-center text-muted rounded-3 shadow-sm">
                    You have no clinic appointments booked currently.
                </div>
            }
            else
            {
                @foreach (var item in Model.ActiveAppointments)
                {
                    string statusBadgeColor = item.Status switch
                    {
                        "Confirmed" => "bg-primary text-white",
                        "Requested" => "bg-warning text-dark",
                        "CheckedIn" => "bg-info text-white",
                        "InProgress" => "bg-secondary text-white",
                        "Completed" => "bg-success text-white",
                        "Cancelled" => "bg-danger text-white",
                        "Missed" => "bg-dark text-white",
                        _ => "bg-secondary text-white"
                    };

                    <div class="card border-0 border-start border-4 border-info shadow-sm mb-3 rounded-2">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <h5 class="mb-1 text-dark font-weight-bold">
                                        Consultation with Dr. @(item.Doctor?.Name ?? "Staff Physician")
                                    </h5>
                                    <p class="text-primary small mb-1">
                                        <i class="bi bi-tag-fill"></i> @item.Specialty Department
                                    </p>
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar-event"></i> @item.AppointmentDate.ToString("F")
                                    </span>
                                </div>
                                <span class="badge @statusBadgeColor px-3 py-2 text-uppercase">
                                    @item.Status 
                                </span>
                            </div>

                            @if (item.Status == "Completed" && item.VisitRecord?.Prescriptions.Any() == true)
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <small class="text-muted fw-bold">
                                        <i class="bi bi-capsule me-1"></i>Prescriptions:
                                    </small>
                                    <div class="mt-2">
                                        @foreach (var rx in item.VisitRecord.Prescriptions)
                                        {
                                            <div class="d-inline-block bg-light border rounded-2 px-3 py-2 me-2 mb-2 small">
                                                <strong>@rx.MedicationName</strong> @rx.Dosage
                                                <span class="text-muted">— @rx.Frequency for @rx.Duration</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (item.Status == "Completed" && item.VisitRecord != null)
                            {
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-journal-medical me-1"></i>
                                        Diagnosis: @item.VisitRecord.Diagnosis
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // FIX #6: Build a map of specialtyName → [{id, name, hours, daysOff}, ...]
        // so when the patient picks a specialty, only matching doctors are shown.
        const specialtyDoctors = {};

        @foreach (var d in Model.ClinicDoctors)
        {
                foreach (var ds in d.DoctorSpecializations)
                {
                        if (ds.Specialization != null)
                        {
                                @:if (!specialtyDoctors["@ds.Specialization.Name"]) specialtyDoctors["@ds.Specialization.Name"] = [];
                                @:specialtyDoctors["@ds.Specialization.Name"].push({
                                @:    id: @d.Id,
                                @:    name: "@d.Name",
                                @:    hours: "@d.WorkingHours",
                                @:    daysOff: "@d.DaysOff"
                                @:});
                        }
                }
        }

        const specialtySelect  = document.getElementById("specialtySelect");
        const specialtyHidden  = document.getElementById("specialtyHidden");
        const doctorSelect     = document.getElementById("doctorSelect");
        const infoBox          = document.getElementById("doctorInfo");
        const infoText         = document.getElementById("doctorInfoText");

        specialtySelect.addEventListener("change", function () {
            const spec = this.value;
            specialtyHidden.value = spec;

            doctorSelect.innerHTML = '<option value="">-- Choose a Doctor --</option>';
            infoBox.classList.add("d-none");

            const doctors = specialtyDoctors[spec] || [];
            if (doctors.length === 0) {
                const opt = document.createElement("option");
                opt.textContent = "No doctors available for this specialty";
                opt.disabled = true;
                doctorSelect.appendChild(opt);
            } else {
                doctors.forEach(doc => {
                    const opt = document.createElement("option");
                    opt.value = doc.id;
                    opt.textContent = "Dr. " + doc.name;
                    opt.setAttribute("data-hours", doc.hours);
                    opt.setAttribute("data-daysoff", doc.daysOff);
                    doctorSelect.appendChild(opt);
                });
            }
        });

        doctorSelect.addEventListener("change", function () {
            const selected = this.options[this.selectedIndex];
            const hours   = selected.getAttribute("data-hours");
            const daysOff = selected.getAttribute("data-daysoff");
            if (this.value && hours) {
                infoText.textContent = `Working Hours: ${hours} | Days Off: ${daysOff}`;
                infoBox.classList.remove("d-none");
            } else {
                infoBox.classList.add("d-none");
            }
        });
    </script>
}
