@using System.Linq
@model Healthcare_System_AdavanceProgrammingProject.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-speedometer2"></i>
            Clinic Manager Dashboard
        </h2>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body">
                    <h5>Total Doctors</h5>
                    <h2>@ViewBag.TotalDoctors</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body">
                    <h5>Total Patients</h5>
                    <h2>@ViewBag.TotalPatients</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark">
                <div class="card-body">
                    <h5>Total Appointments</h5>
                    <h2>@ViewBag.TotalAppointments</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-dark text-white">
                <div class="card-body">
                    <h5>Specializations</h5>
                    <h2>@ViewBag.TotalSpecializations</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                Management Actions
            </h5>
        </div>

        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Doctors"
                   asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-person-badge"></i>
                    Manage Doctors
                </a>

                

            </div>

        </div>
    </div>

    <!-- Doctors -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                Doctors
            </h5>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Working Hours</th>
                        <th>Days Off</th>
                        <th>Specializations</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var doctor in Model.ClinicDoctors)
                    {
                        <tr>

                            <td>
                                <strong>@doctor.Name</strong>
                            </td>

                            <td>
                                @doctor.Email
                            </td>

                            <td>
                                @doctor.WorkingHours
                            </td>

                            <td>
                                @doctor.DaysOff
                            </td>

                            <td>

                                @foreach (var spec in doctor.DoctorSpecializations)
                                {
                                    <span class="badge bg-primary me-1">
                                        @spec.Specialization.Name
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>