<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">   
                <a class="navbar-brand font-weight-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill text-danger"></i> CareClinic 
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning font-weight-bold" asp-area="" asp-controller="PublicLookup" asp-action="Index">
                                <i class="bi bi-search"></i> Public Lookup
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Workspace Dashboard
                                </a>
                            </li>

                            
                                    

                            @* Receptionist + Clinic Manager *@
                            @if (User.IsInRole("Receptionist") ||
                                 User.IsInRole("ClinicManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white"
                                       asp-controller="Patients"
                                       asp-action="Index">
                                        Patient Files
                                    </a>
                                </li>
                            }

                            @* ONLY Clinic Manager *@
                            @if (User.IsInRole("ClinicManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white"
                                       asp-controller="Doctors"
                                       asp-action="Index">
                                        Doctors Roster
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-white"
                                       asp-controller="Specializations"
                                       asp-action="Index">
                                        Specialty Roster
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-white"
                                       asp-controller="Receptionists"
                                       asp-action="Index">
                                        Reception Roster
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav navbar-right">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                            <span class="navbar-text text-white-50 small me-3">
                                Active Session:
                                <strong class="text-white">
                                    @User.Identity.Name?.Split('@')[0]
                                </strong>
                            </span>

                            <a class="nav-link text-info p-0"
                               asp-controller="Profile"
                               asp-action="Index">
                                <i class="bi bi-person-circle"></i> My Profile
                            </a>
                        </li>
                                
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1">Secure Sign Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary px-3 text-uppercase font-weight-bold font-small text-white" asp-controller="Account" asp-action="Login">
                                    Portal Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>