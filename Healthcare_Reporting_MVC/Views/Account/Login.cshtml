

@model HealthcareClinic.ReportingApp.Models.LoginViewModel
@{

    ViewData["Title"] = "Clinic Manager Portal";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clinic Reporting Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <style>

            body {
                background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .login-card {

                background: rgba(255,255,255,0.05);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 16px;
                padding: 2.5rem;
                width: 100%;

                max-width: 420px;
                color: white;
            }

                .login-card h2 {
                    font-weight: 700;
                    letter-spacing: -0.5px;
                }

            .form-control {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                color: white;

                border-radius: 8px;
            }

                .form-control:focus {


                    background: rgba(255,255,255,0.12);
                    border-color: #00c6ff;
                    color: white;
                    box-shadow: 0 0 0 3px rgba(0,198,255,0.2);
                }

                .form-control::placeholder {
                    color: rgba(255,255,255,0.4);
                }

            .btn-login {
                background: linear-gradient(90deg, #00c6ff, #0072ff);
                border: none;
                border-radius: 8px;
                font-weight: 600;

                letter-spacing: 0.5px;
                padding: 0.75rem;

                color: white;
                transition: opacity 0.2s;
            }

                .btn-login:hover {
                    opacity: 0.9;
                    color: white;
                }

            .badge-restricted {
                background: rgba(255,50,50,0.15);
                border: 1px solid rgba(255,50,50,0.3);
                color: #ff6b6b;
                border-radius: 20px;

                font-size: 0.7rem;
                padding: 4px 10px;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">

            <i class="bi bi-bar-chart-fill fs-1 text-info"></i>
            <h2 class="mt-2">Reporting Portal</h2>
            <span class="badge-restricted"><i class="bi bi-shield-lock-fill me-1"></i>Clinic Manager Access Only</span>
        </div>

        @if (Model?.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2 small">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.ErrorMessage
            </div>
        }

        <form asp-action="Login" method="post">

            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small text-white-50">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="manager@clinic.com" required />
            </div>
            <div class="mb-4">

                <label class="form-label small text-white-50">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-login w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>Access Reports
            </button>
        </form>
    </div>
</body>
</html>
