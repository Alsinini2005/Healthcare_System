@model HealthcareClinic.ReportingApp.Models.OperationalReportModel
@{
    ViewData["Title"] = "Operational Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="topbar">
    <div>
        <h5 class="mb-0 fw-bold">Operational Report</h5>
        <small class="text-muted">Appointment statistics & doctor utilization</small>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@if (Model == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Could not load report data from the API.
    </div>
}
else
{
    @* ── Appointment Statistics ── *@
    <div class="stat-card mb-4">
        <h6 class="fw-bold mb-3"><i class="bi bi-calendar-check me-2 text-primary"></i>Appointment Statistics</h6>
        <div class="row text-center g-3">
            <div class="col">
                <div class="fs-4 fw-bold text-primary">@Model.TotalAppointments</div>
                <div class="text-muted small">Total</div>
            </div>
            <div class="col">
                <div class="fs-4 fw-bold text-success">@Model.CompletedAppointments</div>
                <div class="text-muted small">Completed</div>
            </div>
            <div class="col">
                <div class="fs-4 fw-bold text-dark">@Model.MissedAppointments</div>
                <div class="text-muted small">Missed</div>
            </div>
            <div class="col">
                <div class="fs-4 fw-bold text-secondary">@Model.MissedRate%</div>
                <div class="text-muted small">Missed Rate</div>
            </div>
        </div>
    </div>

    @* ── Doctor Utilization ── *@
    <div class="stat-card">
        <h6 class="fw-bold mb-3"><i class="bi bi-person-badge me-2 text-info"></i>Doctor Utilization & Workload Distribution</h6>

        @if (!Model.DoctorUtilizationMetrics.Any())
        {
            <p class="text-muted">No doctor utilization data available.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th class="text-center">Appointments</th>
                        <th>Utilization</th>
                        <th class="text-center">Share %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.DoctorUtilizationMetrics.OrderByDescending(d => d.UtilizationPercentage))
                    {
                        <tr>
                            <td class="fw-bold">Dr. @doc.DoctorName</td>
                            <td class="text-center">
                                <span class="badge bg-primary px-3">@doc.BookedAppointmentsCount</span>
                            </td>
                            <td style="width:35%">
                                <div class="progress" style="height:8px; border-radius:10px;">
                                    <div class="progress-bar bg-info"
                                         style="width:@doc.UtilizationPercentage%"></div>
                                </div>
                            </td>
                            <td class="text-center text-muted small">@doc.UtilizationPercentage%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
